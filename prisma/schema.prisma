generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Provider {
  id              String         @id @default(cuid())
  clerkOrgId      String         @unique
  name            String
  timezone        String
  currency        String         @default("USD")
  schedules       WorkingHours[]
  capacityBuckets CapacityBucket[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model WorkingHours {
  id              String           @id @default(cuid())
  providerId      String
  provider        Provider         @relation(fields: [providerId], references: [id], onDelete: Cascade)
  dayOfWeek       Int
  openTime        String
  closeTime       String
  capacityPerHour Int
  isActive        Boolean          @default(true)
  capacityBuckets CapacityBucket[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([providerId, dayOfWeek])
}

model CapacityBucket {
  id             String       @id @default(cuid())
  providerId     String
  provider       Provider     @relation(fields: [providerId], references: [id], onDelete: Cascade)
  workingHoursId String
  workingHours   WorkingHours @relation(fields: [workingHoursId], references: [id], onDelete: Cascade)
  slotStart      DateTime
  slotEnd        DateTime
  maxCapacity    Int
  booked         Int          @default(0)
  version        Int          @default(0)

  @@unique([providerId, slotStart])
  @@index([providerId, slotStart, slotEnd])
}
